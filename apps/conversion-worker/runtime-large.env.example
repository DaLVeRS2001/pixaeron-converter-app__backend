# Burst worker runtime environment reference. Production values below are
# stored as separate AWS Systems Manager Parameter Store parameters under
# /pixaeron/production/conversion-worker-large. This file is documentation
# only.
#
# The burst container shares the conversion-worker image. NODE_ENV,
# WORKER_PROGRESS_FILE and WORKER_QUEUE_SET=paid-large come from
# docker-compose.worker.yaml, so this file never sets them. WORKER_SLOTS stays
# at its default of 1: large files are processed one at a time.
#
# Deploy gates, in order:
# 1. the pixaeron-conversion-paid-large queue and its DLQ must exist;
# 2. the worker baseline IAM policy must allow receive/delete on it
#    (the baseline grant deliberately excluded it while nothing consumed it);
# 3. these parameters must exist in Parameter Store, because every release
#    renders every manifest row and fails on an empty path;
# 4. the instance must be resized to at least the $24/4GB plan before this
#    container runs: a 100-megapixel decode peaks near a gigabyte, which the
#    1 GB box cannot hold next to the main worker.

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID

# SecureString parameters for the pixaeron-worker-baseline IAM user.
AWS_ACCESS_KEY_ID=REPLACE_WITH_WORKER_BASELINE_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_WORKER_BASELINE_SECRET_KEY

CONVERSION_S3_BUCKET=pixaeron-conversion-production

# The PRO plan ceiling: paid files between the api's
# CONVERSION_LARGE_QUEUE_BYTES and this value land on the paid-large queue.
WORKER_MAX_INPUT_BYTES=157286400

# Sized against the 1536 MB container limit: a 100 MP RGBA decode is ~400 MB
# and libvips peaks at a multiple of it. Real 150 MB photographs are commonly
# 60-100 MP, so anything lower rejects the very files this lane exists for.
WORKER_MAX_PIXELS=100000000
