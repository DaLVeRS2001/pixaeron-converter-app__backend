# Paid-large Fargate task environment reference. Production values below are
# stored as separate AWS Systems Manager Parameter Store parameters under
# /pixaeron/production/conversion-worker-large and injected into the task
# definition as secrets. This file is documentation only.
#
# The task runs the same conversion-worker image. NODE_ENV=production,
# WORKER_QUEUE_SET=paid-large and WORKER_PROGRESS_FILE come from the task
# definition's plain environment, so this file never sets them. WORKER_SLOTS
# stays at its default of 1: large files are processed one at a time, and the
# service scales 0 -> 1 on queue depth instead of adding slots.
#
# Unlike the Lightsail worker, the task authenticates with its task ROLE
# (pixaeron-worker-burst in the infrastructure guide), so no AWS access keys
# appear here.
#
# Deploy gates, in order:
# 1. the pixaeron-conversion-paid-large queue and its DLQ must exist;
# 2. the pixaeron-worker-burst task role must allow receive/delete on it,
#    reads on inputs/*, writes on outputs/*, and send on the events queue;
# 3. these parameters must exist before the task definition references them.

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID

CONVERSION_S3_BUCKET=pixaeron-conversion-production

# The PRO plan ceiling: paid files between the api's
# CONVERSION_LARGE_QUEUE_BYTES and this value land on the paid-large queue.
WORKER_MAX_INPUT_BYTES=157286400

# Measured on the same code as the small lane: one lossy AVIF job peaks at
# roughly 120 MB plus 42 MB per megapixel of total RSS, so 100 MP needs about
# 4.3 GB. Real 150 MB photographs are commonly 60-100 MP, so lowering this
# would reject the very files this lane exists for; the task is sized at 8 GB
# instead. Raising it past 100 MP needs a bigger task, not just a bigger
# number here.
WORKER_MAX_PIXELS=100000000
