# Conversion worker runtime environment reference. Production values below are
# stored as separate AWS Systems Manager Parameter Store parameters under
# /pixaeron/production/conversion-worker. This file is documentation only.
#
# NODE_ENV and WORKER_PROGRESS_FILE come from docker-compose.worker.yaml, and
# SQS_QUEUE_SUFFIX stays unset in production so the live queues are used.

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID

# SecureString parameters for the pixaeron-worker-baseline IAM user.
AWS_ACCESS_KEY_ID=REPLACE_WITH_WORKER_BASELINE_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_WORKER_BASELINE_SECRET_KEY

CONVERSION_S3_BUCKET=pixaeron-conversion-production

# Hard reject ceiling for THIS container: an input above it fails with
# INPUT_TOO_LARGE, and the download is capped at the same size. Must equal the
# api's CONVERSION_LARGE_QUEUE_BYTES: paid files above that threshold are
# routed to the paid-large queue and processed by the Fargate lane with its
# own, higher ceiling (see runtime-large.env.example).
WORKER_MAX_INPUT_BYTES=26214400

# Rejects anything larger with PIXELS_EXCEEDED, so it is a product limit before
# it is a memory limit: a stock phone photo is 4032x3024 = 12.2 MP and an APS-C
# camera is 24 MP, and nothing routes an oversized file elsewhere (admission
# picks the queue by bytes alone). Keep it above the cameras you intend to
# serve, then size the container and WORKER_SLOTS to fit, never the reverse.
WORKER_MAX_PIXELS=24000000

# Which queues this process polls. The Lightsail worker polls the four tier
# queues ("tiers"); the paid-large Fargate task polls only
# pixaeron-conversion-paid-large ("paid-large") and must never run before that
# queue exists with receive rights, or its poll loop dies on startup.
WORKER_QUEUE_SET=tiers

# Concurrent processing slots. The pro queue fans out to min(8, WORKER_SLOTS),
# every other tier stays at one file at a time.
#
# The budget is 120 MB + 42 MB x megapixels x WORKER_SLOTS, and it must fit the
# container limit in docker-compose.worker.yaml (1536 MB). The AVIF encoder
# sets that 42, measured as total RSS for one lossy job: 24 MP 1141 MB,
# 12 MP 631 MB, 8 MP 464 MB. So at 24 MP one slot needs ~1141 MB and fits,
# while two need ~2161 MB and do not. Two slots would mean a ceiling under
# 17 MP, which rejects every 24 MP camera; serving those files matters more
# than on-box parallelism, which stage 4 of the scalability plan delivers with
# Fargate replicas instead. Raise this only together with the container limit
# and a fresh measurement.
WORKER_SLOTS=1
