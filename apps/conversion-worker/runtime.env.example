# Conversion worker runtime environment reference. Production values below are
# stored as separate AWS Systems Manager Parameter Store parameters under
# /pixaeron/production/conversion-worker. This file is documentation only.
#
# NODE_ENV and WORKER_PROGRESS_FILE come from docker-compose.worker.yaml, and
# SQS_QUEUE_SUFFIX stays unset in production so the live queues are used.

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID

# SecureString parameters for the pixaeron-worker-baseline IAM user.
AWS_ACCESS_KEY_ID=REPLACE_WITH_WORKER_BASELINE_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_WORKER_BASELINE_SECRET_KEY

CONVERSION_S3_BUCKET=pixaeron-conversion-production

# Hard reject ceiling for THIS container: an input above it fails with
# INPUT_TOO_LARGE, and the download is capped at the same size. Must equal the
# api's CONVERSION_LARGE_QUEUE_BYTES: paid files above that threshold are
# routed to the paid-large queue and processed by the burst container with its
# own, higher ceiling (see runtime-large.env.example).
WORKER_MAX_INPUT_BYTES=26214400

# Sized against the main container's 768 MB limit: libvips peaks at several
# times the raw pixel buffer, so raise this only with benchmark evidence (or
# after raising the container limit).
WORKER_MAX_PIXELS=24000000

# Which queues this process polls. The main worker polls the four tier queues
# ("tiers"); the burst companion polls only pixaeron-conversion-paid-large
# ("paid-large") and must never run before that queue exists with receive
# rights, or its poll loop dies on startup.
WORKER_QUEUE_SET=tiers

# Concurrent processing slots. Budget ~200 MB of container memory per slot at
# 24 MP; the pro queue fans out to min(8, WORKER_SLOTS) while every other tier
# stays at one file at a time. Keep 1 until the instance is resized.
WORKER_SLOTS=1
