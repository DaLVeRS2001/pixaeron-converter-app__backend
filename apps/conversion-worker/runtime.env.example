# Conversion worker runtime environment reference. Production values below are
# stored as separate AWS Systems Manager Parameter Store parameters under
# /pixaeron/production/conversion-worker. This file is documentation only.
#
# NODE_ENV and WORKER_PROGRESS_FILE come from docker-compose.worker.yaml, and
# SQS_QUEUE_SUFFIX stays unset in production so the live queues are used.

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID

# SecureString parameters for the pixaeron-worker-baseline IAM user.
AWS_ACCESS_KEY_ID=REPLACE_WITH_WORKER_BASELINE_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_WORKER_BASELINE_SECRET_KEY

CONVERSION_S3_BUCKET=pixaeron-conversion-production

CONVERSION_LARGE_FILE_BYTES=26214400

# Sized against the 768 MB container limit on the 1 GB instance: libvips peaks
# at several times the raw pixel buffer, so raise this only with benchmark
# evidence (or after resizing the instance).
WORKER_MAX_PIXELS=24000000
