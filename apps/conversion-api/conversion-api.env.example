NODE_ENV=development
PORT=3005

# Docker Compose value. For a direct Windows run, use 127.0.0.1:5435.
DATABASE_URL=postgresql://conversion:conversion@conversion-postgres:5432/pixaeron_conversion?schema=public

CORS_ORIGINS=http://localhost:3000

# Docker Compose uses auth:50053. For a direct Windows run, use 127.0.0.1:50053.
ENTITLEMENTS_GRPC_URL=auth:50053
ENTITLEMENTS_GRPC_DEADLINE_MS=2000
CONVERSION_LARGE_FILE_BYTES=26214400
# ENTITLEMENTS_COMMAND_SECRET=

REDIS_URL=redis://127.0.0.1:6379
IP_HASH_SECRET=GENERATE_a_random_value_at_least_32_chars

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID
AWS_ACCESS_KEY_ID=REPLACE_WITH_CONVERSION_API_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_CONVERSION_API_SECRET_KEY
CONVERSION_S3_BUCKET=pixaeron-conversion-dev

# Local development targets the -dev queue copies. Omit in production.
SQS_QUEUE_SUFFIX=-dev
