NODE_ENV=development
PORT=3005

# Docker Compose value. For a direct Windows run, use 127.0.0.1:5435.
DATABASE_URL=postgresql://conversion:conversion@conversion-postgres:5432/pixaeron_conversion?schema=public

CORS_ORIGINS=http://localhost:3000

# Docker Compose uses auth:50053. For a direct Windows run, use 127.0.0.1:50053.
ENTITLEMENTS_GRPC_URL=auth:50053
ENTITLEMENTS_GRPC_DEADLINE_MS=2000
# ENTITLEMENTS_COMMAND_SECRET=
