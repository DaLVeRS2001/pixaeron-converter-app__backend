# Conversion API runtime environment reference. Production values below are
# stored as separate AWS Systems Manager Parameter Store parameters under
# /pixaeron/production/conversion-api. This file is documentation only.
#
# NODE_ENV, PORT, REDIS_URL, ENTITLEMENTS_GRPC_URL and
# ENTITLEMENTS_GRPC_DEADLINE_MS come from docker-compose.production.yaml, and
# SQS_QUEUE_SUFFIX stays unset in production so the live queues are used.

# SecureString. Dedicated database and login role, matching the auth pattern:
# the role owns the database and its public schema, and CONNECT is revoked from
# PUBLIC. Generate the password from letters and digits only — reserved
# characters would need percent-encoding and fail at startup, not at setup.
DATABASE_URL=postgresql://pixaeron_conversion:REPLACE_WITH_ROLE_PASSWORD@REPLACE_WITH_RDS_HOST:5432/dbconversion?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem

CORS_ORIGINS=https://pixaeron.com,https://www.pixaeron.com

# SecureString. Salts the anonymous visitor identity; rotating it detaches every
# in-flight anonymous batch from its owner, so rotate only between releases.
IP_HASH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=REPLACE_WITH_12_DIGIT_AWS_ACCOUNT_ID

# SecureString parameters for the pixaeron-conversion-api IAM user.
AWS_ACCESS_KEY_ID=REPLACE_WITH_CONVERSION_API_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_CONVERSION_API_SECRET_KEY

CONVERSION_S3_BUCKET=pixaeron-conversion-production

# Routing threshold only: paid files above it go to the paid-large queue. It is
# not a size limit — the worker's own ceiling is WORKER_MAX_INPUT_BYTES at
# /pixaeron/production/conversion-worker, above which it fails the file with
# INPUT_TOO_LARGE. The two were one parameter until 2026-08-16 and must now be
# reasoned about separately: the worker's ceiling has to clear the largest file
# any queue it consumes can carry.
CONVERSION_LARGE_QUEUE_BYTES=26214400

# SecureString. Shared with /pixaeron/production/auth/ENTITLEMENTS_COMMAND_SECRET
# and must hold the identical value: auth authenticates the entitlements gRPC
# channel against it. When it is absent on the auth side the guard admits every
# caller, so both parameters exist or the channel is unprotected.
ENTITLEMENTS_COMMAND_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
