# Dedicated GraphOS runtime key used by Router licensed JWT/authorization features.
APOLLO_KEY=
APOLLO_GRAPH_REF=pixaeron@production

# Must exactly match the access-token claims issued by Auth.
JWT_ISSUER=http://localhost:3001/auth
JWT_AUDIENCE=pixaeron-api

# Exact browser origin allowed to send credentialed GraphQL requests.
FRONTEND_ORIGIN=http://localhost:3000
