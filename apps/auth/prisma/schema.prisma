generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlanCode {
  FREE
  LIGHT
  PRO
}

enum SessionRevokedReason {
  LOGOUT
  LOGOUT_ALL
  REFRESH_REUSE
  PASSWORD_CHANGED
  EXPIRED
  ADMIN_REVOKED
  SECURITY_RISK
}

enum SessionEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REGISTER_SUCCESS
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFICATION_ACCEPTED
  EMAIL_VERIFICATION_FAILED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_INVALID
  EMAIL_VERIFICATION_EXPIRED
  EMAIL_ALREADY_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_SENT
  PASSWORD_RESET_ACCEPTED
  PASSWORD_RESET_FAILED
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_INVALID
  PASSWORD_RESET_EXPIRED
  PASSWORD_RESET_REUSED
  REFRESH_SUCCESS
  REFRESH_FAILED
  REFRESH_REUSE_DETECTED
  LOGOUT
  LOGOUT_ALL
  SESSION_EXPIRED
  PASSWORD_CHANGED
  SUSPICIOUS_IP
  SUSPICIOUS_USER_AGENT
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id                     Int            @id @default(autoincrement())
  publicId               String         @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  email                  String         @unique
  password               String?
  username               String
  emailVerified          Boolean        @default(false) @map("email_verified")
  planCode               PlanCode       @default(FREE) @map("plan_code")
  legalConsentVersion    String?        @map("legal_consent_version")
  legalConsentAcceptedAt DateTime?      @map("legal_consent_accepted_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  accounts               Account[]
  authTokens             AuthToken[]
  sessions               Session[]
  sessionEvents          SessionEvent[]

  @@map("users")
}

// The partial unique index auth_tokens_one_active_per_user_type is maintained by SQL migration.
model AuthToken {
  id String @id @default(uuid())

  userId Int @map("user_id")

  type AuthTokenType

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime @map("expires_at")

  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model Account {
  id                String   @id @default(uuid())
  userId            Int      @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  email             String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id               String                @id @default(uuid())
  userId           Int                   @map("user_id")
  // Active credential hash used by session-level compare-and-swap rotation.
  refreshTokenHash String                @map("refresh_token_hash")
  expiresAt        DateTime              @map("expires_at")
  revokedAt        DateTime?             @map("revoked_at")
  revokedReason    SessionRevokedReason? @map("revoked_reason")
  lastUsedAt       DateTime?             @map("last_used_at")
  rotatedAt        DateTime?             @map("rotated_at")
  rememberMe       Boolean               @default(false) @map("remember_me")
  userAgent        String?               @map("user_agent")
  ipHash           String?               @map("ip_hash")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  events        SessionEvent[]
  refreshTokens SessionRefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model SessionRefreshToken {
  id             String    @id @default(uuid())
  sessionId      String    @map("session_id")
  credentialHash String    @map("secret_hash")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_refresh_tokens")
}

model SessionEvent {
  id        String           @id @default(uuid())
  sessionId String?          @map("session_id")
  userId    Int?             @map("user_id")
  type      SessionEventType
  ipHash    String?          @map("ip_hash")
  userAgent String?          @map("user_agent")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("session_events")
}
