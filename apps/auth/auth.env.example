NODE_ENV=development
PORT=3001
# Docker Compose uses the private service address below. When Auth runs directly on Windows, use 127.0.0.1:5433 instead of postgres:5432.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/pixaeron_auth?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_DER_BASE64
# JWT_PREVIOUS_PUBLIC_KEY_BASE64=OPTIONAL_PREVIOUS_SPKI_DER_BASE64
JWT_ISSUER=http://localhost:3001/auth
JWT_AUDIENCE=pixaeron-api
JWT_EXPIRATION_MS=900000
REFRESH_EXPIRATION_MS=604800000
SESSION_REFRESH_EXPIRATION_MS=86400000
PASSWORD_HASH_ROUNDS=12
REFRESH_TOKEN_HASH_ROUNDS=12
IP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET

CORS_ORIGINS=http://localhost:3000,https://pixaeron.com,https://www.pixaeron.com
FRONTEND_URL=http://localhost:3000

CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=
CAPTCHA_HOSTNAME=

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

EMAIL_DELIVERY_ENABLED=false
AWS_REGION=eu-central-1
SES_FROM_EMAIL=Pixaeron <no-reply@pixaeron.com>
