NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USERNAME:URL_ENCODED_PASSWORD@PRIVATE_DB_ENDPOINT:5432/dbauth?schema=public&sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRATION_MS=900000
REFRESH_EXPIRATION_MS=604800000
SESSION_REFRESH_EXPIRATION_MS=86400000
REFRESH_TOKEN_HASH_ROUNDS=12
IP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET

CORS_ORIGINS=http://localhost:3000,https://pixaeron.com,https://www.pixaeron.com
FRONTEND_URL=http://localhost:3000

CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=
CAPTCHA_HOSTNAME=

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

EMAIL_DELIVERY_ENABLED=false
AWS_REGION=eu-central-1
SES_FROM_EMAIL=Pixaeron <no-reply@pixaeron.com>
