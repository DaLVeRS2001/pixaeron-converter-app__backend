NODE_ENV=development
PORT=3004
# Docker Compose can use the private database service address. For a direct Windows run, use the published host port.
DATABASE_URL=postgresql://notifications:notifications@notifications-postgres:5432/pixaeron_notifications?schema=public

NOTIFICATIONS_GRPC_HOST=127.0.0.1
NOTIFICATIONS_GRPC_PORT=50052

# Generate each key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SecureString JSON. Keep every key version referenced by retained delivery or destination rows.
RECIPIENT_HMAC_KEYRING_JSON={"1":"REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY"}
RECIPIENT_HMAC_ACTIVE_KEY_VERSION=1

# Dedicated Notifications runtime IAM access key. Never reuse the GitHub deployment identity.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_NOTIFICATIONS_RUNTIME_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NOTIFICATIONS_RUNTIME_SECRET_ACCESS_KEY

SES_FROM_EMAIL=Pixaeron <no-reply@pixaeron.com>
SES_CONFIGURATION_SET=pixaeron-transactional
SES_REQUEST_TIMEOUT_MS=1500
FRONTEND_URL=https://pixaeron.com

# Keep false for unit/local work without a real queue. Production must use true after AWS feedback resources exist.
SES_FEEDBACK_CONSUMER_ENABLED=false
SES_FEEDBACK_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/pixaeron-ses-feedback
SES_FEEDBACK_TOPIC_ARN=arn:aws:sns:eu-central-1:123456789012:pixaeron-ses-feedback
SES_EXPECTED_ACCOUNT_ID=123456789012
SES_EXPECTED_SOURCE_ARN=arn:aws:ses:eu-central-1:123456789012:identity/pixaeron.com