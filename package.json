{
  "name": "@pixaeron/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "docker:start": "docker compose up -d --build",
    "docker:recreate": "docker compose up -d --build --force-recreate",
    "docker:stop": "docker compose down",
    "schema:export": "nx run-many -t schema-export",
    "schema:check": "nx run-many -t schema-check",
    "contracts:generate": "nx run notifications-contract:contracts-generate",
    "contracts:check": "nx run notifications-contract:contracts-check",
    "contracts:breaking": "nx run notifications-contract:contracts-breaking",
    "check": "nx run-many --targets=lint,test,build"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/jest": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/nest": "23.0.1",
    "@nx/node": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/webpack": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@swc/helpers": "~0.5.18",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "axios": "1.x",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "lint-staged": "^16.4.0",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "ts-proto": "2.12.0",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1",
    "webpack-merge": "^6.0.1"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "valibot": "1.4.2",
    "@nestjs/graphql": {
      "ws": "8.21.1",
      "subscriptions-transport-ws": {
        "ws": "7.5.13"
      }
    }
  }
}
