[
  {
    "project": "notifications",
    "host": "application",
    "deploymentOrder": 5,
    "imageName": "ghcr.io/dalvers2001/pixaeron-notifications",
    "dockerfile": "apps/notifications/Dockerfile",
    "composeService": "notifications",
    "imageTagEnv": "NOTIFICATIONS_IMAGE_TAG",
    "ssmPath": "/pixaeron/production/notifications",
    "secureParameters": [
      "DATABASE_URL",
      "RECIPIENT_HMAC_KEYRING_JSON",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "NOTIFICATIONS_COMMAND_SECRET"
    ],
    "runtimeEnvFileEnv": "NOTIFICATIONS_RUNTIME_ENV_FILE",
    "migrationCommand": "./node_modules/.bin/prisma migrate deploy --config apps/notifications/prisma.config.ts"
  },
  {
    "project": "auth",
    "host": "application",
    "deploymentOrder": 10,
    "imageName": "ghcr.io/dalvers2001/pixaeron-auth",
    "dockerfile": "apps/auth/Dockerfile",
    "composeService": "auth",
    "imageTagEnv": "AUTH_IMAGE_TAG",
    "ssmPath": "/pixaeron/production/auth",
    "secureParameters": [
      "DATABASE_URL",
      "JWT_PRIVATE_KEY_BASE64",
      "IP_HASH_SECRET",
      "CAPTCHA_SECRET_KEY",
      "NOTIFICATIONS_COMMAND_SECRET"
    ],
    "runtimeEnvFileEnv": "AUTH_RUNTIME_ENV_FILE",
    "migrationCommand": "./node_modules/.bin/prisma migrate deploy --config apps/auth/prisma.config.ts"
  },
  {
    "project": "gateway",
    "host": "application",
    "deploymentOrder": 100,
    "imageName": "ghcr.io/dalvers2001/pixaeron-gateway",
    "dockerfile": "apps/gateway/Dockerfile",
    "composeService": "gateway",
    "imageTagEnv": "GATEWAY_IMAGE_TAG",
    "ssmPath": "/pixaeron/production/gateway",
    "secureParameters": ["APOLLO_KEY"],
    "runtimeEnvFileEnv": "GATEWAY_RUNTIME_ENV_FILE",
    "migrationCommand": ""
  },
  {
    "project": "conversion-worker",
    "host": "worker",
    "deploymentOrder": 200,
    "imageName": "ghcr.io/dalvers2001/pixaeron-conversion-worker",
    "dockerfile": "apps/conversion-worker/Dockerfile",
    "composeService": "conversion-worker",
    "imageTagEnv": "CONVERSION_WORKER_IMAGE_TAG",
    "ssmPath": "/pixaeron/production/conversion-worker",
    "secureParameters": ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"],
    "runtimeEnvFileEnv": "CONVERSION_WORKER_RUNTIME_ENV_FILE",
