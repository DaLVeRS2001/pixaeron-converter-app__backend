# Auth runtime environment reference. Production values below are stored as
# separate AWS Systems Manager Parameter Store parameters under
# /pixaeron/production/auth. This file is documentation only.

DATABASE_URL=postgresql://USERNAME:URL_ENCODED_PASSWORD@PRIVATE_DB_ENDPOINT:5432/dbauth?schema=public&sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem

JWT_PRIVATE_KEY_BASE64=REPLACE_WITH_PKCS8_DER_BASE64
# JWT_PREVIOUS_PUBLIC_KEY_BASE64=OPTIONAL_PREVIOUS_SPKI_DER_BASE64
JWT_ISSUER=https://api.pixaeron.com/auth
JWT_AUDIENCE=pixaeron-api
JWT_EXPIRATION_MS=900000
REFRESH_EXPIRATION_MS=604800000
SESSION_REFRESH_EXPIRATION_MS=86400000
PASSWORD_HASH_ROUNDS=12
REFRESH_TOKEN_HASH_ROUNDS=12
IP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_SECRET

CORS_ORIGINS=https://pixaeron.com,https://www.pixaeron.com

CAPTCHA_ENABLED=false
CAPTCHA_SECRET_KEY=
CAPTCHA_HOSTNAME=

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

EMAIL_DELIVERY_ENABLED=false

# SecureString. Same value as the notifications path; the guard enforces.
NOTIFICATIONS_COMMAND_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# SecureString. Same value as the conversion-api path; the guard enforces.
ENTITLEMENTS_COMMAND_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
